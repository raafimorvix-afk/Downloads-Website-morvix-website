# Copy to .env.local for local development. On the live site these are set in the hosting dashboard, never committed.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only: used to create staff logins

# Hostinger email (the mailbox that sends leads to clients)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=                      # e.g. leads@wearemorvix.com
SMTP_PASS=
MAIL_FROM_NAME=Morvix LLC

# Stripe (restricted key: Payment Links + Prices + Products write, Checkout Sessions read)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
